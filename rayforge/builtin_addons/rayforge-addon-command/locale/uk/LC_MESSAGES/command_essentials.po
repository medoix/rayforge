#: command_essentials/widgets/command_page.py
msgid "Machine Code"
msgstr "Код машини"

#: command_essentials/widgets/command_page.py
#, python-brace-format
msgid ""
"One line per command, emitted at this step's position in the workflow. Path "
"variables like {machine.name} and {layer.name} are expanded when the job is "
"encoded."
msgstr ""
"Один рядок на команду, що видається в позиції цього кроку в робочому "
"процесі. Змінні шляху, як-от {machine.name} і {layer.name}, "
"розгортаються під час кодування завдання."

#: command_essentials/steps/command_step.py
msgid "Command"
msgstr "Команда"

#: command_essentials/steps/command_step.py
msgid "No machine code"
msgstr "Немає коду машини"

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid "{count} lines"
msgstr "{count} рядків"

#: command_essentials/steps/command_step.py
msgid "The command step has no machine code."
msgstr "Крок команди не містить коду машини."

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid ""
"The '{name}' driver does not support custom machine code; the lines are not "
"emitted for this machine."
msgstr ""
"Драйвер «{name}» не підтримує користувацький код машини; рядки для "
"цієї машини не видаються."

#: command_essentials/steps/command_step.py
msgid "None"
msgstr "Немає"