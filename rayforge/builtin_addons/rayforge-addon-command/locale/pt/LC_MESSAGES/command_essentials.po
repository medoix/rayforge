#: command_essentials/widgets/command_page.py
msgid "Machine Code"
msgstr "Código de máquina"

#: command_essentials/widgets/command_page.py
#, python-brace-format
msgid ""
"One line per command, emitted at this step's position in the workflow. Path "
"variables like {machine.name} and {layer.name} are expanded when the job is "
"encoded."
msgstr ""
"Uma linha por comando, emitida na posição desta etapa no fluxo de "
"trabalho. Variáveis de caminho como {machine.name} e {layer.name} "
"são expandidas quando o trabalho é codificado."

#: command_essentials/steps/command_step.py
msgid "Command"
msgstr "Comando"

#: command_essentials/steps/command_step.py
msgid "No machine code"
msgstr "Sem código de máquina"

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid "{count} lines"
msgstr "{count} linhas"

#: command_essentials/steps/command_step.py
msgid "The command step has no machine code."
msgstr "A etapa de comando não tem código de máquina."

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid ""
"The '{name}' driver does not support custom machine code; the lines are not "
"emitted for this machine."
msgstr ""
"O driver '{name}' não suporta código de máquina personalizado; as "
"linhas não são emitidas para esta máquina."

#: command_essentials/steps/command_step.py
msgid "None"
msgstr "Nenhum"