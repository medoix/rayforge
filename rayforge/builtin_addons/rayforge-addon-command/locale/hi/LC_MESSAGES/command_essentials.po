#: command_essentials/widgets/command_page.py
msgid "Machine Code"
msgstr "मशीन कोड"

#: command_essentials/widgets/command_page.py
#, python-brace-format
msgid ""
"One line per command, emitted at this step's position in the workflow. Path "
"variables like {machine.name} and {layer.name} are expanded when the job is "
"encoded."
msgstr ""
"प्रति कमांड एक पंक्ति, वर्कफ़्लो में इस चरण की स्थिति पर उत्सर्जित। "
"{machine.name} और {layer.name} जैसे पथ चर जॉब एन्कोड होने पर "
"विस्तारित हो जाते हैं।"

#: command_essentials/steps/command_step.py
msgid "Command"
msgstr "कमांड"

#: command_essentials/steps/command_step.py
msgid "No machine code"
msgstr "कोई मशीन कोड नहीं"

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid "{count} lines"
msgstr "{count} पंक्तियाँ"

#: command_essentials/steps/command_step.py
msgid "The command step has no machine code."
msgstr "कमांड चरण में कोई मशीन कोड नहीं है।"

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid ""
"The '{name}' driver does not support custom machine code; the lines are not "
"emitted for this machine."
msgstr ""
"'{name}' ड्राइवर कस्टम मशीन कोड का समर्थन नहीं करता; इस मशीन के लिए "
"पंक्तियाँ उत्सर्जित नहीं होतीं।"

#: command_essentials/steps/command_step.py
msgid "None"
msgstr "कोई नहीं"