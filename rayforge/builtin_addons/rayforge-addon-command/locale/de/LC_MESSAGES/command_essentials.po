#: command_essentials/widgets/command_page.py
msgid "Machine Code"
msgstr "Maschinencode"

#: command_essentials/widgets/command_page.py
#, python-brace-format
msgid ""
"One line per command, emitted at this step's position in the workflow. Path "
"variables like {machine.name} and {layer.name} are expanded when the job is "
"encoded."
msgstr ""
"Eine Zeile pro Befehl, ausgegeben an der Position dieses Schritts im "
"Workflow. Pfadvariablen wie {machine.name} und {layer.name} werden "
"beim Encodieren des Auftrags expandiert."

#: command_essentials/steps/command_step.py
msgid "Command"
msgstr "Befehl"

#: command_essentials/steps/command_step.py
msgid "No machine code"
msgstr "Kein Maschinencode"

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid "{count} lines"
msgstr "{count} Zeilen"

#: command_essentials/steps/command_step.py
msgid "The command step has no machine code."
msgstr "Der Befehlsschritt enthält keinen Maschinencode."

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid ""
"The '{name}' driver does not support custom machine code; the lines are not "
"emitted for this machine."
msgstr ""
"Der Treiber „{name}“ unterstützt keinen benutzerdefinierten "
"Maschinencode; die Zeilen werden für diese Maschine nicht "
"ausgegeben."

#: command_essentials/steps/command_step.py
msgid "None"
msgstr "Keiner"