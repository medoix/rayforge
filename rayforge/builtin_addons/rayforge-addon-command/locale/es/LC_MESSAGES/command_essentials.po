#: command_essentials/widgets/command_page.py
msgid "Machine Code"
msgstr "Código de máquina"

#: command_essentials/widgets/command_page.py
#, python-brace-format
msgid ""
"One line per command, emitted at this step's position in the workflow. Path "
"variables like {machine.name} and {layer.name} are expanded when the job is "
"encoded."
msgstr ""
"Una línea por comando, emitida en la posición de este paso en el "
"flujo de trabajo. Las variables de ruta como {machine.name} y "
"{layer.name} se expanden al codificar el trabajo."

#: command_essentials/steps/command_step.py
msgid "Command"
msgstr "Comando"

#: command_essentials/steps/command_step.py
msgid "No machine code"
msgstr "Sin código de máquina"

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid "{count} lines"
msgstr "{count} líneas"

#: command_essentials/steps/command_step.py
msgid "The command step has no machine code."
msgstr "El paso de comando no tiene código de máquina."

#: command_essentials/steps/command_step.py
#, python-brace-format
msgid ""
"The '{name}' driver does not support custom machine code; the lines are not "
"emitted for this machine."
msgstr ""
"El controlador «{name}» no admite código de máquina personalizado; "
"las líneas no se emiten para esta máquina."

#: command_essentials/steps/command_step.py
msgid "None"
msgstr "Ninguno"